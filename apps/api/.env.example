DATABASE_URL="postgresql://regimen_works:regimen_works@localhost:5432/regimen_works?schema=public"

# The throwaway database the DB-backed suites use (`npm run test:db`). Same
# server as DATABASE_URL above, different database -- it is dropped and
# recreated on every run, so it must never point at a database you care about.
# Optional: the default below is what the code assumes when this is unset.
TEST_DATABASE_URL="postgresql://regimen_works:regimen_works@localhost:5432/regimen_works_test?schema=public"

PORT=3001
# Comma-separated CORS allowlist. Defaults to the Vite dev server when unset.
WEB_ORIGIN="http://localhost:5173"

# From dashboard.clerk.com > API keys. Server-side only — never sent to the browser.
CLERK_SECRET_KEY="sk_test_replace_me"

# The Clerk user id of the browser test user (dashboard.clerk.com > Users),
# used by `npm run seed:e2e` to give that athlete a known History and Stats.
# Not a secret -- a user id is not a credential -- but it is per-instance, so
# it lives here rather than being committed. See the README.
# E2E_USER_ID="user_2ab..."

# The database the browser suite (DN-72) runs against. Dropped and recreated on
# every run -- never point this at a database you care about. Optional; the
# default below is what the code assumes when unset.
# E2E_DATABASE_URL="postgresql://regimen_works:regimen_works@localhost:5432/regimen_works_e2e?schema=public"
