generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Mirrors the Clerk user. `id` is Clerk's own user id (e.g. "user_2ab..."),
// not a locally generated one, so there is a single source of truth for
// identity and no mapping table. Rows are created lazily on a user's first
// authenticated request; Clerk remains authoritative for everything else.
model User {
  id String @id

  assignments   DailyAssignment[]
  sessions      WorkoutSession[]
  logs          WorkoutLog[]
  skillLevels   SkillLevel[]
  scheduleRule  ScheduleRule?
  substitutions AssignmentSubstitution[]

  // Library content this athlete authored (DN-93). Global rows carry no
  // owner and appear in nobody's list here.
  ownExercises Exercise[]
  ownWods      Wod[]
  ownPlans     Plan[]

  enrollments PlanEnrollment[]
}

model Exercise {
  id       String  @id @default(cuid())
  name     String
  // Null only for general warm-up/cool-down filler not tied to a pattern
  // (Feature #63, e.g. light jogging, deep breathing).
  pattern  String? // push | pull | squat | hinge | core | cardio | null
  scalable Boolean @default(false)
  unit     String  @default("reps") // reps | seconds — seconds for timed holds (e.g. plank family)

  // What the movement needs beyond the athlete's own body, drawn from the
  // shared catalog (DN-77): bar | jump_rope | box | dumbbell | kettlebell.
  // Empty is the baseline and by far the common case — bodyweight is not a
  // tag, it is the absence of one.
  //
  // A String[] rather than a join table: the set is tiny, it is read on every
  // scheduler pass alongside the exercise row itself, and a join buys nothing.
  // Validated in the application (`equipment` in packages/shared) rather than
  // by the database, the same way `pattern` and `line` are.
  equipment String[] @default([])

  // How the movement is performed, in prose — the setup, the rep, and the
  // one or two cues that decide whether it's the movement at all. Every
  // seeded exercise has one (the seed type requires it); nullable only so a
  // row added outside the seed isn't blocked on copy that hasn't been
  // written yet. Never the home of rep counts or scaling advice: counts are
  // WodMovement.reps, and the easier variant is already altExerciseId.
  instructions String?

  // Progression tracking (Feature #2) — finer-grained than `pattern`, since a
  // pattern like push or core actually contains multiple independent skill
  // lines (push_horizontal vs push_vertical; core_dynamic/core_hold/core_side).
  // Null for exercises not yet part of a tracked ladder (e.g. cardio).
  line String?
  rung Int? // position within that line's chain, 0-indexed

  // Warm-up/cool-down tagging (Feature #63) — independent of `pattern`/`line`
  // so an exercise still carries its `pattern` for WOD matching while also
  // being usable as warm-up/cool-down content. Null for exercises not part
  // of either checklist.
  phase String? // warmup | cooldown | null

  altExerciseId String?
  altExercise   Exercise?  @relation("ExerciseAlt", fields: [altExerciseId], references: [id])
  substitutes   Exercise[] @relation("ExerciseAlt")

  // Which tier of the library this row belongs to (DN-93).
  //
  //   null -- global content. Seeded, admin-curated, readable by everyone.
  //   set  -- that athlete's own. Readable and writable only by them.
  //
  // Nullable rather than a sentinel id so the global tier needs no fake user
  // row, and so the foreign key can cascade: deleting an athlete takes their
  // library with them and leaves the shared one alone.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  wodMovements  WodMovement[]
  substitutedIn AssignmentSubstitution[]
  // The program slots that pin this exercise by name rather than by line
  // (DN-19).
  prescribedIn  PlanSlotMovement[]

  // Soft delete (DN-25). Archiving hides the row from every pool and picker --
  // `libraryVisibleTo` filters it out, so the scheduler, the ladder and the
  // swap panel stop offering it -- while leaving it resolvable through the
  // relations that already point at it. A hard delete cannot do that: a
  // `WodMovement` or a logged `AssignmentSubstitution` naming this row would
  // either block the delete or lose the movement's name out of the athlete's
  // own history.
  //
  // Note it does NOT free the name: the unique index over (ownerId, name)
  // counts archived rows, so re-using an archived name means un-archiving it.
  archivedAt DateTime?

  // Scoped to the owner so two athletes may both write "Push-up" (DN-93). A
  // personal name is allowed to shadow a global one -- the alternative
  // reserves every global name forever, and an admin seeding a name an
  // athlete already used would make the athlete's own row unwritable.
  //
  // NOT the whole constraint. Postgres treats NULLs as distinct, so this
  // alone permits two *global* rows of the same name -- exactly the guarantee
  // the seed's upsert depends on. A partial unique index over `name` WHERE
  // "ownerId" IS NULL closes that, and it lives only in the migration:
  // Prisma cannot express a partial index, so `prisma migrate dev` will offer
  // to drop it on the next model change. Keep it.
  @@unique([ownerId, name])
}

// Current rung per progression line — one row per line, v1 single-user (see
// User). Read by the scheduler when generating a WOD and advanced/dropped
// by the 3x8-to-3x5 rule after a result is logged (Feature #2).
model SkillLevel {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  line      String // push_horizontal | push_vertical | pull | squat | hinge | core_dynamic | core_hold | core_side
  rung      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, line])
}

model Wod {
  id              String  @id @default(cuid())
  name            String
  type            String // amrap | for_time | emom | tabata
  timeCapMinutes  Int
  rounds          Int?
  // How the workout is meant to be performed, in prose — the part no other
  // field can carry ("one pass, for time" vs. "as many rounds as possible").
  // Null on WODs whose movement list already says everything. Never the home
  // of the rep numbers themselves: those live in WodMovement.repScheme, so
  // the two can't disagree.
  description     String?
  // Interval structure for the emom/tabata timer (Feature #30). Null on
  // AMRAP/For Time, and on interval WODs seeded before these existed —
  // `resolveIntervalConfig` in packages/shared fills those in with the
  // format's classic structure (EMOM 60s, Tabata 20s work / 10s rest x 8).
  workSeconds     Int?
  restSeconds     Int?
  intervalCount   Int?
  isNamed         Boolean @default(false)
  dominantPattern String // push | pull | squat | hinge | core | cardio

  // Which tier of the library this row belongs to (DN-93).
  //
  //   null -- global content. Seeded, admin-curated, readable by everyone.
  //   set  -- that athlete's own. Readable and writable only by them.
  //
  // Nullable rather than a sentinel id so the global tier needs no fake user
  // row, and so the foreign key can cascade: deleting an athlete takes their
  // library with them and leaves the shared one alone.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  movements   WodMovement[]
  assignments DailyAssignment[]
  planSlots   PlanSlot[]

  // Soft delete, same semantics as Exercise.archivedAt (DN-25). Written by
  // DN-26's endpoints; it lands here early because `libraryVisibleTo` filters
  // on it for both models, and a helper that meant one thing for Exercise and
  // another for Wod is the kind of difference nobody remembers at the call
  // site.
  archivedAt DateTime?

  // Scoped to the owner so two athletes may both write "Push-up" (DN-93). A
  // personal name is allowed to shadow a global one -- the alternative
  // reserves every global name forever, and an admin seeding a name an
  // athlete already used would make the athlete's own row unwritable.
  //
  // NOT the whole constraint. Postgres treats NULLs as distinct, so this
  // alone permits two *global* rows of the same name -- exactly the guarantee
  // the seed's upsert depends on. A partial unique index over `name` WHERE
  // "ownerId" IS NULL closes that, and it lives only in the migration:
  // Prisma cannot express a partial index, so `prisma migrate dev` will offer
  // to drop it on the next model change. Keep it.
  @@unique([ownerId, name])
}

model WodMovement {
  id         String   @id @default(cuid())
  wodId      String
  wod        Wod      @relation(fields: [wodId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  reps       Int
  order      Int

  // Per-round counts for a descending/ascending ladder — [21, 15, 9] for a
  // 21-15-9. Empty means "flat": the movement is `reps` every round, which is
  // every WOD that isn't a ladder. Empty rather than null because Prisma has
  // no optional scalar list; `hasRepScheme` in packages/shared is the check to
  // use rather than testing the array by hand.
  //
  // `reps` stays the total (sum of the scheme) so the advancement math and the
  // split anchor keep reading one number. A CHECK constraint added in this
  // field's migration holds `reps = sum(repScheme)` whenever a scheme is set —
  // the two can never drift, whatever writes the row.
  repScheme Int[] @default([])

  substitutions AssignmentSubstitution[]
}

// One active row per user, read by the scheduler.
model ScheduleRule {
  id                    String  @id @default(cuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Which weekdays this athlete trains on, 0 = Sunday … 6 = Saturday — the
  // numbering `Date.getUTCDay()` uses, stated in full on `trainingDaysSchema`
  // in packages/shared. The scheduler's rest-day check is a lookup in here.
  //
  // This replaced `maxDaysPerWeek`, a pure quota that knew how many days but
  // never which (DN-12). "Days per week" is now the length of this array and
  // never a column of its own, so the two can no longer disagree.
  //
  // The default is Mon–Fri, which is the spread the old `@default(5)` quota
  // backfilled to, and must stay in step with DEFAULT_TRAINING_DAYS.
  trainingDays          Int[]   @default([1, 2, 3, 4, 5])
  // How long before a WOD's name or dominant pattern may come round again.
  // Exposed through /settings since DN-27, where the bounds (0 = off, 30 =
  // the widest window the scheduler's `take: 30` history can honour) are
  // stated on `patternCooldownDaysSchema`. The default must stay in step with
  // DEFAULT_PATTERN_COOLDOWN_DAYS.
  patternCooldownDays   Int     @default(5)
  warmupCooldownEnabled Boolean @default(false) // Feature #63 opt-in
  // Whether reaching a WOD's time cap stops the clock and ends the session.
  // Defaults true because that is how the timer is meant to run; this is an
  // opt-out for an athlete who'd rather keep moving past the cap and stop it
  // themselves. Snapshotted onto each WorkoutSession at start, so flipping it
  // never changes the rules under a workout already in progress.
  autoStopAtCapEnabled  Boolean @default(true)

  // What the athlete owns, from the shared catalog (DN-77) — the standing
  // fact the scheduler resolves a WOD against, as opposed to the per-day
  // swap, which is an AssignmentSubstitution.
  //
  // Lives here rather than in a join table or a model of its own because
  // ScheduleRule is already the one-row-per-user home of every athlete
  // preference, already @unique on userId, and already upserted by
  // SettingsService. A join would add a second read on the scheduler's hot
  // path to express a set of at most five short strings.
  //
  // The default is the baseline the app has always assumed: bodyweight, which
  // is no tag at all, plus the bar. It is the only default that changes no
  // existing athlete's workouts (DN-81), and it must stay in step with
  // SettingsService.DEFAULTS.
  equipment String[] @default(["bar"])
}

model DailyAssignment {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // ISO date, one assignment per day per user
  wodId  String? // null for a rest day recorded before any WOD was generated
  wod    Wod?    @relation(fields: [wodId], references: [id])
  status String  @default("scheduled") // scheduled | in_progress | completed | skipped

  // Which program day this was, when a program produced it (DN-9). All three
  // are null on a Just WODs day, and stay null until DN-16 teaches `getToday`
  // to resolve the day through an enrollment -- nothing writes them yet.
  //
  // `planDayIndex` is denormalised on purpose. It is derivable from the date
  // and the enrollment's start date, but it is what "day 17 of 24" on the
  // completion card counts, and recomputing a date difference on every row of
  // a history page to answer it is work the write already knows the answer to.
  enrollmentId String?
  // The same composite (id, userId) foreign key WorkoutSession and WorkoutLog
  // use, so an assignment cannot claim an enrollment belonging to someone
  // else -- the cross-user drift is unrepresentable rather than merely avoided.
  //
  // NoAction states the intent: deleting an enrollment a trained day points at
  // is refused, so history cannot be quietly detached from the program it was
  // part of. Measured (DN-9), Restrict and even the SetNull Prisma would pick
  // by default refuse it too -- SetNull because `userId` is half this key and
  // NOT NULL, so there is no null to set. The one that behaves differently is
  // Cascade, which would take the athlete's training day with the enrollment.
  // So read this as a guard against Cascade, not as a fine distinction between
  // the other three.
  enrollment   PlanEnrollment? @relation(fields: [enrollmentId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  planSlotId   String?
  // Same intent: an authored slot cannot be deleted while a day the athlete
  // trained points at it. Editing a program people are running has to archive
  // rather than delete, the answer DN-25 reached for Exercise and Wod --
  // history is not rewritten by a later edit.
  planSlot     PlanSlot?       @relation(fields: [planSlotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  planDayIndex Int?

  session       WorkoutSession?
  log           WorkoutLog?
  substitutions AssignmentSubstitution[]

  @@unique([userId, date])
  // Not redundant with the id primary key: it is the target of the composite
  // foreign keys on WorkoutSession and WorkoutLog, which is what stops a row
  // claiming an owner different from its assignment's. Don't remove it.
  @@unique([id, userId])
}

// A movement the athlete swapped before training, for this day only
// (WOD-5). The athlete owns their level; this is the write path, and the
// permanent rung change is confirmed afterwards from what these rows say
// was actually trained (WOD-6).
//
// Keyed by WodMovement rather than by exercise because a WOD can name the
// same line twice, and only the row the athlete tapped should move. Applied
// as an override on top of the current-rung substitution at read time, for
// the same reason that one happens at read time: `Wod` is shared library
// content and must not be mutated per user.
model AssignmentSubstitution {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId  String
  // See WorkoutSession: the same composite FK, so a substitution can't claim
  // an assignment belonging to another user.
  assignment    DailyAssignment @relation(fields: [assignmentId, userId], references: [id, userId], onDelete: Cascade)
  // **Exactly one of these two.** A CHECK in DN-125's migration holds it, the
  // same shape of rule as PlanSlotMovement's own line/exerciseId xor.
  //
  // A swap is keyed by the movement the athlete tapped rather than by the
  // exercise, so a day naming the same line twice moves only the row they
  // touched -- and since DN-125 a day can be straight sets rather than a WOD,
  // which has no WodMovement anywhere in it. Two nullable FKs rather than one
  // polymorphic id column, so the database still refuses a swap pointing at a
  // movement that does not exist.
  wodMovementId      String?
  wodMovement        WodMovement?      @relation(fields: [wodMovementId], references: [id], onDelete: Cascade)
  planSlotMovementId String?
  planSlotMovement   PlanSlotMovement? @relation(fields: [planSlotMovementId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise        @relation(fields: [exerciseId], references: [id])
  createdAt     DateTime        @default(now())
  // Moves when the swap is corrected, which createdAt doesn't — the upsert
  // below keeps the original row. It is what orders two swaps on the same
  // line, so the completion screen can offer the one chosen most recently
  // (DN-88).
  updatedAt     DateTime        @updatedAt

  // One swap per movement per day: swapping twice corrects the choice, it
  // doesn't stack. The write is an upsert on whichever of these keys the
  // tapped movement belongs to.
  //
  // These are the partial indexes DN-125 wanted, spelled as something Prisma
  // can express: Postgres treats NULLs as distinct, so the wodMovementId index
  // constrains exactly the rows that have one and ignores every prescribed-day
  // row, and vice versa. A raw partial index would say the same thing and cost
  // the upserts their compound key.
  @@unique([assignmentId, wodMovementId])
  @@unique([assignmentId, planSlotMovementId])
}

// The live timer's state. roundSplits is jsonb: [{ round, atSeconds }],
// written on every "round complete" tap so a locked phone or a refresh
// never loses progress. Native jsonb rather than JSON-in-text (its shape
// under SQLite, see #39) so the database itself rejects a malformed write
// instead of it surfacing as a parse error on the next read.
model WorkoutSession {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId      String          @unique
  // Composite FK: userId is denormalised so every per-user model scopes the
  // same way, and referencing (id, userId) makes Postgres reject a session
  // whose owner disagrees with its assignment's. The drift is unrepresentable
  // rather than merely avoided by careful writes.
  assignment        DailyAssignment @relation(fields: [assignmentId, userId], references: [id, userId], onDelete: Cascade)
  startedAt         DateTime        @default(now())
  // Where this session's clock stops. Null on a straight-sets session
  // (DN-20), which is untimed on purpose: the athlete works at their own
  // pace, and the only clock on that screen is the rest between sets.
  //
  // Null rather than 0. A zero cap is a cap that has already been reached, so
  // `wasCappedFinish` would call every prescribed session capped and the log
  // screen would report a clock that stopped at 0:00.
  capSeconds        Int?
  roundSplits       Json            @default("[]") // RoundSplit[]
  // What the athlete actually trained (DN-90): the WOD's movement list after
  // the current-rung scaling and the day's swaps were applied, written once
  // when the session starts. Snapshotted for the same reason capSeconds and
  // autoStopAtCap are -- a workout runs under the rules it began with -- and
  // because nothing else keeps it: the rung, the swap rows and the exercise
  // names all keep moving, so a past day re-read through them describes
  // today's settings, not that day's training. Exercise name/line/rung are
  // copied rather than referenced so a renamed or re-rung exercise cannot
  // rewrite history. jsonb, like roundSplits, so a malformed write is refused
  // at the database. Empty only on sessions older than this column.
  movements         Json            @default("[]") // SessionMovement[]
  status            String          @default("in_progress") // in_progress | completed | abandoned
  finishedAtSeconds Int? // elapsed time when "Finish" was tapped — the natural score for a For Time WOD
  roundSplitCount   Int? // optional user-chosen round count to break high-rep movements into; null = unsplit
  // Whether this session's clock stops at capSeconds, copied from
  // ScheduleRule.autoStopAtCapEnabled when the session starts. Snapshotted for
  // the same reason capSeconds is: a workout runs under the rules it began
  // with, and every read of them (the screen's clock, the finish time, the
  // past-cap round guard) then costs no extra lookup.
  autoStopAtCap     Boolean         @default(true)

  // Feature #63 — stamped when each checklist is finished; read later for stats.
  warmupCompletedAt   DateTime?
  cooldownCompletedAt DateTime?

  // Feature #30 — how far the EMOM/Tabata interval timer has got, written on
  // every interval rollover for the same reason roundSplits is written on
  // every tap: a locked phone or a refresh must not restart the sequence.
  intervalIndex            Int? // 0-based interval in progress; == intervalCount once the sequence has run out
  intervalStartedAtSeconds Int? // elapsed seconds (from startedAt) at which that interval began

  // DN-20 -- how far a straight-sets session has got, written on every set for
  // the same reason intervalIndex is written on every rollover: a locked phone
  // or a refresh must not put the athlete back on set one.
  //
  // One counter rather than a movement index beside a set index. Two columns
  // can say "movement 2, set 7" about a movement with five sets; one number
  // cannot, and the client posting the absolute count makes a replayed tap
  // rewrite rather than count the set twice. Resolved back to a position
  // against this session's own `movements` -- see `straightSetsStateAt`.
  //
  // Null on a WOD. 0 on a prescribed session nobody has finished a set of yet,
  // which is a different fact.
  setsCompleted            Int?
  // Elapsed seconds at which the rest after the last set began; null while the
  // athlete is working. When it started rather than what is left of it, so a
  // backgrounded tab resumes the countdown at the right second.
  restStartedAtSeconds     Int?

  // Required by Prisma for the composite relation above. assignmentId is
  // already unique on its own, so this adds no further restriction.
  @@unique([assignmentId, userId])
}

model WorkoutLog {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId String          @unique
  // See WorkoutSession: same composite FK, same reason.
  assignment   DailyAssignment @relation(fields: [assignmentId, userId], references: [id, userId], onDelete: Cascade)
  resultType   String // time_seconds | rounds_reps | total_reps
  resultValue  String // e.g. "1122" (seconds), "17+3" (rounds+reps), "220" (total reps)
  rpe          Int?
  notes        String?
  createdAt    DateTime        @default(now())

  // See WorkoutSession: required by Prisma for the composite relation.
  @@unique([assignmentId, userId])
}

// A program: what each training day is, for as long as the athlete runs it
// (DN-9). Shared library content like `Wod`, and owned the same way.
//
// Nothing reads these four models yet. They land ahead of the code because
// "Just WODs is itself a program" (docs/design/programs.md) only pays off if
// `getToday` can be written with one path instead of two, and that rewrite
// (DN-16) needs a plan to already exist to resolve against.
model Plan {
  id      String  @id @default(cuid())
  // The name the athlete picks it by, e.g. "Pull-Up Builder".
  name    String
  // One line under the name in the picker. Required: a program nobody can
  // tell apart from the next one is not a program anyone will choose.
  summary String
  // What finishing it is supposed to get you, where that is a single nameable
  // thing ("your first unassisted chin-up"). Null for programs that are a
  // way of training rather than a target -- Just WODs is exactly that.
  goal    String?

  // fixed | flexible -- whether the cadence screen is an input or a readout.
  //
  //   flexible -- the athlete taps which weekdays they train, bounded by
  //               min/maxDaysPerWeek and starting from `defaultDays`.
  //   fixed    -- the slot layout IS the schedule. This is what lets a
  //               program insist on spacing rather than mere frequency:
  //               48 hours between heavy pull days is Mon/Tue/Thu/Fri, which
  //               "4 days a week" cannot say.
  //
  // The CHECK in this field's migration keeps the two modes from blurring:
  // fixed carries neither bound, flexible carries both.
  scheduleMode   String
  minDaysPerWeek Int?
  maxDaysPerWeek Int?
  // Which weekdays the picker starts on for a flexible program, 0 = Sunday,
  // the same numbering as ScheduleRule.trainingDays. Empty for fixed, where
  // the slots already answer it -- not CHECKed, because "empty" is also the
  // honest value for a flexible program with no opinion about which days.
  defaultDays    Int[]  @default([])

  // How many weeks the athlete may run it for, and where the picker starts.
  // All three are null for an open-ended program: Just WODs never finishes,
  // so there is no length to choose and no last day to complete on. A length
  // is therefore a property of a program, not of every program.
  //
  // `minWeeks` has to be at least intro + one whole core block + peak, or
  // `expandPlanWeeks` (DN-11) truncates mid-wave and the program ends on a
  // light week. That is a count of PlanWeek rows, so it is checked where the
  // rows are visible rather than by a constraint here.
  minWeeks     Int?
  maxWeeks     Int?
  defaultWeeks Int?

  // Which tier of the library this row belongs to, exactly as on Exercise and
  // Wod (DN-93): null is global, admin-curated content; set is that athlete's
  // own. "Build your own program", stubbed in DN-15's wizard, is the owned
  // case, and the column is cheaper to add now -- while nothing points at a
  // Plan -- than after enrollments do.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  weeks       PlanWeek[]
  enrollments PlanEnrollment[]

  // Scoped to the owner, and paired with a partial unique index over global
  // names, for the reasons written out in full on Exercise: Postgres treats
  // NULLs as distinct, so this alone would permit two global plans of the
  // same name. The partial index cannot be expressed here and lives only in
  // the migration -- `prisma migrate dev` will offer to drop it. Keep it.
  @@unique([ownerId, name])
}

// One authored week of a program.
//
// `phase` is what makes a program scale to a length the athlete chose:
// `expandPlanWeeks` (DN-11) plays the intro weeks in order, cycles the core
// weeks to fill the middle, then plays the peak weeks. Core weeks cycle **in
// order and never shuffled**, because escalation is authored as a wave across
// the block (3x5, 4x5, 5x5, repeat) rather than applied by a multiplier --
// shuffling them flattens the wave into noise.
model PlanWeek {
  id     String  @id @default(cuid())
  planId String
  plan   Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  // Position within the program as authored, 0-indexed. Not the week the
  // athlete is in: that is a count from their start date, and one authored
  // week can be played several times.
  order  Int
  phase  String // intro | core | peak
  // Shown on the program's calendar preview, e.g. "Deload". Null where the
  // week has nothing to say beyond its number.
  label  String?

  slots PlanSlot[]

  @@unique([planId, order])
}

// One day of one authored week. `kind` is the fork that makes a training day
// something other than a WOD:
//
//   rest          -- the program's own rest day, which is not the same fact as
//                    the athlete not having picked that weekday.
//   wod_pinned    -- this exact WOD, for a benchmark re-test.
//   wod_generated -- constraints the existing pickWod resolves against the
//                    library (DN-14).
//   movements     -- prescribed sets and reps. The columns carrying the
//                    prescription are DN-19's; this model reserves the `kind`
//                    so the fork is complete, and nothing writes that value
//                    until they exist.
model PlanSlot {
  id         String   @id @default(cuid())
  planWeekId String
  planWeek   PlanWeek @relation(fields: [planWeekId], references: [id], onDelete: Cascade)
  // 0 = Sunday … 6 = Saturday, the numbering Date.getUTCDay() uses and the
  // same one ScheduleRule.trainingDays is in. One slot per weekday per week,
  // because resolveSlotForDate (DN-11) looks the day up by its weekday.
  dayOfWeek  Int
  kind       String

  // Which days survive when a flexible program runs at fewer days per week
  // than it was authored for: lower is kept first, so the program's main
  // session is 0. Without it, dropping 5 days to 3 keeps whichever days fall
  // earliest in the week, which can delete the point of the program.
  //
  // Never read for a fixed program, where every authored day is trained.
  priority Int @default(0)

  // The pinned WOD. A CHECK in this field's migration holds it non-null
  // exactly when `kind` is wod_pinned -- a pinned day with nothing pinned and
  // a rest day pointing at a WOD are both states the database refuses rather
  // than states the writer is trusted to avoid.
  wodId String?
  wod   Wod?    @relation(fields: [wodId], references: [id])

  // The wod_generated constraints. Explicit nullable columns rather than
  // jsonb because there are few of them and they are filtered on; the schema
  // keeps jsonb for genuinely open shapes. A null skips its axis.
  //
  // `allowNamed` defaults false because programs mostly program movement
  // rather than benchmarks, and a named WOD landing in the middle of a
  // progression block is the surprise that default protects against.
  pattern           String? // push | pull | squat | hinge | core | cardio
  wodType           String? // amrap | for_time | emom | tabata
  allowNamed        Boolean @default(false)
  maxTimeCapMinutes Int?

  // The prescription, on a `movements` slot (DN-19). Empty on every other
  // kind. The database cannot hold that rule -- `kind` lives on this table
  // and the rows on another, which no CHECK can span -- so `resolveProgramDay`
  // is where it is read, and a `movements` slot with nothing prescribed falls
  // back rather than handing the athlete an empty day.
  movements PlanSlotMovement[]

  assignments DailyAssignment[]

  @@unique([planWeekId, dayOfWeek])
}

// One prescribed movement on a `movements` day: "pull, 5x3, rest 90s"
// (DN-19). The shape a program uses where the session is straight sets rather
// than a WOD.
//
// Sets and reps sit here directly -- no multiplier and no progression rule.
// An author wanting escalation writes a core block that already waves
// (3x5 / 4x5 / 5x5), which `expandPlanWeeks` then repeats as a wave. A
// multiplier would put the same fact in two places and let them disagree.
model PlanSlotMovement {
  id         String   @id @default(cuid())
  planSlotId String
  planSlot   PlanSlot @relation(fields: [planSlotId], references: [id], onDelete: Cascade)
  // Position in the session, 0-based, the way WodMovement.order is.
  order      Int

  // **Exactly one of these two.** A CHECK in this model's migration holds it.
  //
  // `line` is the one to reach for: naming the progression line rather than a
  // specific exercise is what lets one program fit every athlete, because the
  // day resolves through the rung they own. `exerciseId` is for the cases
  // where the specific variation is the point -- a program teaching the
  // negative names the negative, and an athlete further up the line should
  // still train it that day.
  line       String? // push_horizontal | push_vertical | pull | squat | ... (see progressionLine)
  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])

  // The day's swaps that key off this row (DN-125). A prescribed movement is
  // swappable for the same reason a WOD's is: the app decides what you do, you
  // decide how hard it is.
  substitutedIn AssignmentSubstitution[]

  sets        Int
  reps        Int
  // Prescribed rest between sets. Not nullable and not defaulted: rest is
  // part of the prescription rather than a detail an author forgot, and 0
  // says "straight through" out loud. A CHECK keeps it non-negative.
  restSeconds Int

  @@unique([planSlotId, order])
}

// One athlete's run at one program.
//
// At most one may be `active` per user, enforced by a partial unique index
// that only the migration can express. Without it two tabs racing on "Start
// program" both succeed and the athlete has two programs claiming the same
// day.
model PlanEnrollment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  // ISO date, stored as text like DailyAssignment.date so the two compare
  // directly. May be in the future: enrolling on Thursday to start Monday is
  // supported outright, and the days in between fall back to Just WODs
  // because `date < startDate` is the whole rule (DN-16). That is why a
  // future start needs no second enrollment and no status-flipping job -- the
  // partial unique index above still holds while the program waits.
  startDate String
  // How many weeks this run lasts, chosen within the plan's bounds. Null for
  // an open-ended program, which has no last day and so never completes.
  weeks     Int?
  status    String @default("active") // active | completed

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Every tracked line's rung on the start date, as { line: rung }. SkillLevel
  // only keeps the current value, so without this a finished program can count
  // sessions but cannot say what changed -- which is the interesting half of
  // the completion card. jsonb rather than a table because it is written once
  // and always read whole.
  startingRungs Json  @default("{}")
  // The completion card's figures, snapshotted when the enrollment completes
  // rather than recomputed on every read of the Completed list. Null while the
  // program is still running, which is also how "has this been completed" reads
  // without a join.
  summary       Json?

  assignments DailyAssignment[]

  // Required by Prisma for DailyAssignment's composite relation. `id` is
  // already the primary key, so this adds no further restriction -- see the
  // identical pair on DailyAssignment.
  @@unique([id, userId])
}
