# Base URL for API calls. Leave unset locally: the default "/api" is proxied
# to the local API by vite.config.ts. In a deployed build there is no proxy,
# so this is set to the API's full origin (e.g. https://your-api.onrender.com).
# VITE_API_BASE_URL=

# From dashboard.clerk.com > API keys. Public by design (inlined into the bundle).
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"

# The Clerk test user the browser suite signs in as -- a "+clerk_test" address,
# which Clerk accepts without sending mail. Not a secret, but per-instance.
# E2E_USER_EMAIL="you+clerk_test@example.com"
